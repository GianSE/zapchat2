<%- include('partials/topo') %>

<div class="cartao centralizado">
  <p class="erro-codigo"><%= status %></p>
  <h1><%= erro.titulo %></h1>
  <p><%= erro.mensagem %></p>

  <% if (erro.itens && erro.itens.length) { %>
    <ul><% erro.itens.forEach((item) => { %><li><%= item %></li><% }) %></ul>
  <% } %>

  <div class="acoes">
    <a class="botao" href="/">Ir para o início</a>
    <a class="botao secundario" href="javascript:history.back()">Voltar</a>
  </div>
</div>

<%- include('partials/rodape') %>
