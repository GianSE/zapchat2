<%- include('../partials/topo') %>

<div class="cartao centralizado">
  <h1>Criar conta</h1>

  <%- include('../partials/erro-formulario') %>

  <form method="post" action="/cadastro">
    <label for="nome">Nome completo *</label>
    <input type="text" id="nome" name="nome" value="<%= dados.nome || '' %>">

    <label for="email">E-mail *</label>
    <input type="email" id="email" name="email" value="<%= dados.email || '' %>" autocomplete="username">

    <div class="campos-2">
      <div>
        <label for="apelido">Apelido</label>
        <input type="text" id="apelido" name="apelido" value="<%= dados.apelido || '' %>">
      </div>
      <div>
        <label for="telefone">Telefone</label>
        <input type="text" id="telefone" name="telefone" placeholder="(99) 99999-9999" value="<%= dados.telefone || '' %>">
      </div>
    </div>

    <div class="campos-2">
      <div>
        <label for="senha">Senha *</label>
        <input type="password" id="senha" name="senha" autocomplete="new-password">
      </div>
      <div>
        <label for="confirmacao">Confirmar senha *</label>
        <input type="password" id="confirmacao" name="confirmacao" autocomplete="new-password">
      </div>
    </div>
    <small>Mínimo de 6 caracteres, com letras e números. A senha é gravada no banco como hash (scrypt).</small>

    <div class="acoes">
      <button type="submit">Cadastrar</button>
      <a class="botao secundario" href="/login">Já tenho conta</a>
    </div>
  </form>
</div>

<%- include('../partials/rodape') %>
