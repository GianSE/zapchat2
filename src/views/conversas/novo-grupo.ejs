<%- include('../partials/topo') %>

<div class="cartao" style="max-width:640px">
  <h1>Novo grupo</h1>

  <%- include('../partials/erro-formulario') %>

  <form method="post" action="/conversas">
    <div class="campos-2">
      <div>
        <label for="nome">Nome do grupo *</label>
        <input type="text" id="nome" name="nome" value="<%= dados.nome || '' %>">
      </div>
      <div>
        <label for="icone">Ícone (emoji)</label>
        <input type="text" id="icone" name="icone" value="<%= dados.icone || '👥' %>">
      </div>
    </div>

    <label for="descricao">Descrição</label>
    <input type="text" id="descricao" name="descricao" value="<%= dados.descricao || '' %>">

    <label>Participantes * <small>(você entra automaticamente como administrador)</small></label>
    <% if (agenda.length === 0) { %>
      <p class="suave">Sua agenda está vazia. <a href="/usuarios">Adicione contatos</a> antes de criar um grupo.</p>
    <% } %>
    <% agenda.forEach((contato) => { %>
      <label class="check">
        <input type="checkbox" name="participantes" value="<%= contato.contatoId %>"
               <%= dados.participantes.includes(String(contato.contatoId)) ? 'checked' : '' %>>
        <%= contato.avatar %> <%= contato.exibicao %>
      </label>
    <% }) %>

    <div class="acoes">
      <button type="submit">Criar grupo</button>
      <a class="botao secundario" href="/conversas">Cancelar</a>
    </div>
  </form>
</div>

<%- include('../partials/rodape') %>
