# Copie este arquivo para ".env" e ajuste os valores conforme o seu ambiente.
# Todos os valores sao opcionais: sem o .env, os padroes abaixo sao usados.

# Porta do servidor Express
PORTA=3000

# String de conexao do MongoDB
MONGODB_URI=mongodb://localhost:27017

# Nome do banco de dados utilizado pela aplicacao
MONGODB_DB=zapchat2

# Tempo maximo (ms) de espera para selecionar o servidor do MongoDB
MONGODB_TIMEOUT=5000

# Chave usada pelo express-session para assinar o cookie da sessao
SESSAO_SEGREDO=troque-esta-chave-por-um-texto-longo-e-aleatorio

# Duracao da sessao sem uso, em minutos
SESSAO_MINUTOS=120

# Nivel minimo registrado no arquivo de log: DEBUG | INFO | AVISO | ERRO
LOG_NIVEL=INFO
